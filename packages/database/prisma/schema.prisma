datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client"
  output     = "./generated"
  engineType = "client"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "./zod"
  config   = "./zod-generator.config.json"
}

model User {
  id                       String                       @id @default(cuid())
  name                     String
  email                    String
  emailVerified            Boolean
  image                    String?
  createdAt                DateTime
  updatedAt                DateTime
  role                     String?
  banned                   Boolean?
  banReason                String?
  banExpires               DateTime?
  onboardingComplete       Boolean                      @default(false)
  paymentsCustomerId       String?
  locale                   String?
  twoFactorEnabled         Boolean?
  lastActiveOrganizationId String?
  sessions                 Session[]
  accounts                 Account[]
  passkeys                 Passkey[]
  invitations              Invitation[]
  purchases                Purchase[]
  members                  Member[]
  twofactors               TwoFactor[]
  notifications            Notification[]
  notificationPreferences  UserNotificationPreference[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  activeOrganizationId String?

  token     String
  createdAt DateTime
  updatedAt DateTime

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id           String    @id @default(cuid())
  accountId    String
  providerId   String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  idToken      String?   @db.Text
  expiresAt    DateTime?
  password     String?

  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime

  createdAt DateTime?
  updatedAt DateTime?

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model TwoFactor {
  id          String  @id @default(cuid())
  secret      String
  backupCodes String
  verified    Boolean @default(false)
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Organization {
  id                 String       @id @default(cuid())
  name               String
  slug               String?
  logo               String?
  createdAt          DateTime
  metadata           String?
  paymentsCustomerId String?
  members            Member[]
  invitations        Invitation[]
  purchases          Purchase[]
  sources            Source[]
  agentOrganizations AgentOrganization[]
  personas           Persona[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

enum PurchaseType {
  SUBSCRIPTION
  ONE_TIME
}

model Purchase {
  id             String        @id @default(cuid())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String?
  type           PurchaseType
  customerId     String
  subscriptionId String?       @unique
  priceId        String
  status         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([subscriptionId])
  @@map("purchase")
}

enum NotificationTarget {
  IN_APP
  EMAIL
}

enum NotificationType {
  WELCOME
  APP_UPDATE
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  data      Json             @default("{}")
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@map("notification")
}

model UserNotificationPreference {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  target    NotificationTarget
  createdAt DateTime           @default(now())

  @@unique([userId, type, target])
  @@map("user_notification_preference")
}

// ---------------------------------------------------------------- voice agents / GHL

/// Which organization owns a gateway agent (agentId is not an FK — agents
/// live on the gateway, not in this DB). One agent belongs to exactly one org.
model AgentOrganization {
  /// gateway agent id (agt_…)
  agentId        String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("agent_organization")
}

enum SourceStatus {
  CONNECTED
  DISCONNECTED
}

/// A connected CRM sub-account/location — an org can have many. One Agent can
/// monitor many Sources (and vice versa) via VoiceAgentSource, letting a
/// single agent be reused across many sub-accounts with per-source dynamic
/// variables (closebot "Sources" model).
model Source {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// user-facing label shown in the Sources table, e.g. "Ace Smog"
  name           String
  /// provider discriminator, e.g. "gohighlevel" — matches the CRM registry
  providerType   String
  /// CRM-reported account/location name
  accountName    String?
  /// denormalized display address for the Sources table
  address        String?
  /// provider-specific connection data (e.g. { locationId, accessToken });
  /// local dev: stored as-is — encrypt before multi-tenant deploy
  config         Json
  status         SourceStatus @default(CONNECTED)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  agentSources VoiceAgentSource[]
  phoneNumbers SourcePhoneNumber[]

  @@index([organizationId])
  @@map("source")
}

/// A phone number provisioned on the engine and mapped to a specific Source.
/// The engine stays CRM-neutral and only knows the number exists; the SaaS owns
/// which Source a number belongs to. `providerRef` is the engine/LiveKit id used
/// to release or re-route the number; `e164` is the dialable number.
model SourcePhoneNumber {
  id       String @id @default(cuid())
  sourceId String
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// dialable E.164 number, e.g. "+16615551234"
  e164     String @unique
  /// engine phone-number id / LiveKit provider ref, used for release & re-route
  providerRef    String?
  /// optional operator label shown in the UI
  label          String?
  /// gateway agent id (agt_…) this number routes inbound calls to, if any
  inboundAgentId String?
  createdAt      DateTime @default(now())

  @@index([sourceId])
  @@map("source_phone_number")
}

/// Many-to-many join between a gateway agent and a Source, carrying the
/// per-(agent, source) CRM field sync rules (field IDs are account-specific,
/// so mappings cannot be shared across sources on the same agent).
model VoiceAgentSource {
  id       String  @id @default(cuid())
  /// gateway agent id (agt_…) — not an FK, agents live on the gateway
  agentId  String
  sourceId String
  source   Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  enabled  Boolean @default(true)

  /// [{ extractField, crmFieldId, crmFieldKey, crmFieldName }]
  fieldMappings Json @default("[]")
  /// [{ tag, mode: "is" | "is_not" }] — contact-tag conditions gating whether
  /// this agent acts for this source (e.g. tag is not "ai off")
  tagFilters    Json @default("[]")
  /// [{ extractField, equals, tag }]
  tagRules      Json @default("[]")
  /// [{ extractField, equals, pipelineId, stageId, pipelineName?, stageName? }]
  stageRules    Json @default("[]")
  /// Job Flow Variables — per-source VALUE overrides for the agent's custom
  /// variable definitions: { <variableName>: <value> }. Merged into the runtime
  /// variables map at dispatch (see mergeCustomVariables).
  variableValues Json @default("{}")
  writeNote     Boolean @default(true)
  /// default calendar for the check_availability / book_appointment live tools
  bookingCalendarId   String?
  bookingCalendarName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, sourceId])
  @@index([agentId])
  @@index([sourceId])
  @@map("voice_agent_source")
}

/// A reusable identity/tone/behavior layer attached to voice agents (the
/// CloseBot-style "persona" concept adapted for voice). Org-scoped. The persona
/// compiles into the agent's global instructions at save/publish time — the
/// engine stores no persona concept, only the resulting instruction text.
model Persona {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// the name the agent uses for itself when speaking (spoken self-identification)
  name           String
  /// operator-only note; NEVER compiled into the prompt
  internalDescription String? @db.Text
  avatarUrl      String?
  /// hex accent color for the persona card in the UI
  themeColor     String?
  /// up to 3 tone/behavior tags rendered as audible behaviors (warm, curious, …)
  styles         String[]     @default([])
  /// custom behavior instructions, appended verbatim as `## HOW TO RESPOND`
  howToRespond   String       @default("") @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("persona")
}

model VoiceEngineWebhook {
  id        String   @id @default(cuid())
  url       String
  secret    String   @db.Text
  gatewayId String
  createdAt DateTime @default(now())

  @@map("voice_engine_webhook")
}

model CrmLiveTool {
  id     String @id @default(cuid())
  userId String
  /// LLM function name registered on the gateway (update_contact, add_tag, …).
  /// One global registration per name — WHICH source a mid-call invocation
  /// acts on is resolved per call from metadata.source_id (see /api/tools/crm),
  /// so multiple sources share the same clean tool names.
  name   String
  /// gateway tool id (tool_…)
  toolId String
  /// per-tool HMAC signing secret — returned by the gateway only on create
  secret String @db.Text
  createdAt DateTime @default(now())

  @@unique([name])
  @@map("crm_live_tool")
}
